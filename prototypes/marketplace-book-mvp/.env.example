# Copy to .env and fill in locally. This file holds ONLY key names, never values.
# P-14 (Secrets Never Leave the Runtime): the real .env is gitignored and must NEVER be
# committed, written into docs, or pasted into an AI chat. Inject secrets via env vars or a
# Secret Manager in your execution environment only.

# --- AI Provider (chosen by the execution environment; default: anthropic) ---
MARKETPLACE_MVP_PROVIDER=anthropic

# Analyzer model, supplied by the environment. Default matches DOMAIN-001 §12.
MARKETPLACE_MVP_MODEL=claude-haiku-4-5

# --- Provider credential (only the active provider's key is needed) ---
# Anthropic provider reads this from the environment:
ANTHROPIC_API_KEY=
# A future provider would read its own key here, e.g. OPENAI_API_KEY=
