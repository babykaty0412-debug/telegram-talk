# Copy to .env and fill in. NEVER commit a real key (ADR-0009 / ADR-0015).
# The only secret this MVP needs is an Anthropic API key, read from the environment.
ANTHROPIC_API_KEY=

# Optional: override the analyzer model. Default matches DOMAIN-001 §12 (speed priority).
MARKETPLACE_MVP_MODEL=claude-haiku-4-5
